{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.11.1"}
        org.openjfx/javafx-controls {:mvn/version "21.0.5"}
        org.openjfx/javafx-base {:mvn/version "21.0.5"}
        org.openjfx/javafx-graphics {:mvn/version "21.0.5"}
        org.openjfx/javafx-fxml {:mvn/version "21.0.5"}

        ;; Krrō 核心
        top.kzre/krro-core {:mvn/version "0.1.0"}
        top.kzre/krro-ui-core {:mvn/version "0.1.0"}

        com.taoensso/timbre {:mvn/version "6.3.1"}
        com.taoensso/tufte {:mvn/version "2.6.3"}
        }

 :aliases
 {:build
  {:deps {io.github.huixiangchen0314/clj-build-template
          {:git/sha "5664761b0ee0aad60f587d14d00ccd8b2dc985e7"}
          org.slf4j/slf4j-nop {:mvn/version "2.0.7"}}
   :ns-default build}
  :run
  {:extra-paths ["target/classes"]
   :main-opts ["-m" "top.kzre.krro.app.core"]}}}